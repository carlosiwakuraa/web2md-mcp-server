{
  "name": "@carlosiwakura/web2md-mcp-server",
  "version": "1.3.1",
  "mcpName": "io.github.carlosiwakuraa/web2md-mcp-server",
  "description": "MCP server that fetches a URL locally and returns faithful GFM Markdown",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "markdown",
    "html-to-markdown",
    "web",
    "fetch",
    "claude",
    "mcpb"
  ],
  "homepage": "https://github.com/carlosiwakuraa/web2md-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/carlosiwakuraa/web2md-mcp-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlosiwakuraa/web2md-mcp-server.git"
  },
  "author": "carlosiwakuraa",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "web2md-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "mcpb:validate": "npm exec --no-install -- mcpb validate manifest.json",
    "mcpb:pack": "bash scripts/build-mcpb.sh"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@mozilla/readability": "^0.6.0",
    "chardet": "^2.2.0",
    "iconv-lite": "^0.7.3",
    "jsdom": "^29.1.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
